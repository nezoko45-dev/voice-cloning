{
  "name": "voice-studio-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Local-first Windows Kokoro text-to-speech desktop app",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "build": {
    "appId": "dev.voiceagent.voicestudio",
    "productName": "Voice Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Voice-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
