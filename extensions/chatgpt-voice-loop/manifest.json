{
  "manifest_version": 3,
  "name": "ChatGPT Dictate → Send → Read Aloud",
  "version": "1.0.0",
  "description": "Automatically starts ChatGPT dictation, stops after a pause, sends the message, and reads the reply aloud.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "action": {
    "default_title": "ChatGPT Voice Loop",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}