{
  "manifest_version": 3,
  "name": "VoiceAgent Pocket",
  "version": "1.4.0",
  "description": "OpenRouter voice assistant with local self-hosted text-to-speech and background audio playback.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "http://127.0.0.1:47831/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "VoiceAgent Pocket",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116"
}
