{
  "manifest_version": 3,
  "name": "VoiceAgent Pocket",
  "version": "1.3.1",
  "description": "A configurable AI voice assistant with guarded background speech recognition and PocketWebTools cloned-speech handoff.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://pocketweb.tools/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pocketweb.tools/voice-cloning*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "VoiceAgent Pocket",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116"
}
